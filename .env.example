# Copy these into Vercel → Project → Settings → Environment Variables.
# For local testing, copy this file to .env (git-ignored) and run: npm run dev

# Hostinger → hPanel → Databases → Remote MySQL shows the host to use.
DB_HOST=your-mysql-host.hstgr.io
DB_PORT=3306
DB_NAME=u000000000_yourdb
DB_USER=u000000000_youruser
DB_PASS=your-database-password
# DB_SSL=true            # only if your MySQL server requires TLS

# Used once to create the admin login (stored as a bcrypt hash in the database).
ADMIN_INITIAL_PASSWORD=change-me-please

# Long random strings. SESSION_SECRET signs admin logins; CRON_SECRET protects /api/cron.
SESSION_SECRET=
CRON_SECRET=

# Set to false to accept any email address, not just @gmail.com
GMAIL_ONLY=true
